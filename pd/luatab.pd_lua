local luatab = pd.Class:new():register("luatab")luatab.data = 0function luatab:initialize(sel, atoms)    -- single inlet for the frequency, bang goes to the single outlet when we    -- finished generating a new waveform    self.inlets = 1    self.outlets = 1        -- the name of the array/table should be in the 1st creation argument    if type(atoms[1]) == "string" then        self.tabname = atoms[1]        return true    else        self:error(string.format("luatab: expected array name, got %s",                               tostring(atoms[1])))        return false    endendfunction luatab:in_1_float(freq)    if type(freq) == "number" then        -- do my thing here.         luatab.data = freq         -- get the Pd array and its length         local t = pd.Table:new():sync(self.tabname)                 if t == nil then            self:error(string.format("luatab: array or table %s not found",                                  self.tabname))            return        end             local l = t:length()        -- Pd array indices are zero-based        t:set(0, freq)    -- this is needed to update the graph display    t:redraw()    else        self:error(string.format("luatab: expected frequency, got %s",                               tostring(freq)))    end endfunction luatab:in_1_bang()   local t = pd.Table:new():sync(self.tabname)   self:outlet(1, "float", {t:get(0)})end